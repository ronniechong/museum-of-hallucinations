# Copy to .env in this directory and fill in real values. Never commit .env.

# API key for the "artist" model that generates hallucinations (e.g. Groq)
ARTIST_MODEL_API_KEY=

# API key for the "curator" model that judges/writes plaques (can be the same provider/key as above)
CURATOR_MODEL_API_KEY=

# Langfuse Cloud (Hobby/free tier) — from the project's Settings > API Keys page
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Database connection string (once a stack/DB is chosen)
DATABASE_URL=
